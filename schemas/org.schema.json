{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Organisation config (samples/<org>/org.yaml)",
  "type": "object",
  "required": ["name", "assessor"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "kind": {"type": "string"},
    "assessor": {"type": "string", "minLength": 1},
    "snapshot": {"type": "string"},
    "manifest": {"type": "string"},
    "questionnaire": {"type": "string"},
    "labels": {"type": "string"},
    "capacity": {"type": "integer", "minimum": 1, "maximum": 10},
    "anchors": {"type": "array", "items": {"type": "string", "pattern": "^(SV|DF|PL|AE|SI|GR|PO|FC)-[1-3]$"}},
    "targets": {
      "type": "object",
      "properties": {
        "default": {"type": "integer", "minimum": 1, "maximum": 5},
        "dimensions": {"type": "object", "propertyNames": {"pattern": "^(SV|DF|PL|AE|SI|GR|PO|FC)$"}, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 5}},
        "capabilities": {"type": "object", "propertyNames": {"pattern": "^(SV|DF|PL|AE|SI|GR|PO|FC)-[1-3]$"}, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 5}}
      },
      "additionalProperties": false
    },
    "repos": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "path": {"type": "string"}}}},
    "links": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "pattern": "^(SV|DF|PL|AE|SI|GR|PO|FC)-[1-3]$"}}}
  },
  "oneOf": [{"required": ["repos", "snapshot"]}, {"required": ["manifest"]}],
  "additionalProperties": false
}
